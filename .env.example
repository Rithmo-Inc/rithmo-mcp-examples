# Copy to .env and fill in.
# The MCP endpoint of a Rithmo instance. Rithmo Cloud, or your self-hosted address.
RITHMO_MCP_URL=https://mcp.rithmo.ai/api/mcp
# A per-organization Rithmo MCP service token (read-only, scoped to one org).
RITHMO_MCP_TOKEN=rmcp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
