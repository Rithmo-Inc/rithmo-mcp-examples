{
  "id": "RithmoQueryDecision",
  "name": "Rithmo — query_decision before acting",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "When clicking Test",
